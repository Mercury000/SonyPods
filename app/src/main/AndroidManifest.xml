<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />

    <queries>
        <package android:name="com.android.settings" />
        <!-- Required on Android 11+ so the About page can resolve a browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name="dev.sonypods.SonyPodsApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SonyPods">

        <activity-alias
            android:name="dev.sonypods.LauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity="dev.sonypods.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Module settings entry remains enabled when the launcher alias is hidden. -->
        <activity android:name="dev.sonypods.MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity android:name="dev.sonypods.PopupActivity"
            android:theme="@style/Theme.SonyPods.Popup"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.sonypods.action.show_pods_ui" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Receives the capability-probe cache pushed by the engine so it can be
             persisted into the shared remote-prefs store (the only writable side). -->
        <receiver
            android:name="dev.sonypods.config.CapabilityCacheReceiver"
            android:exported="true" />
<!-- Receives engine state while the app has no activity so catalog images
             are downloaded immediately after a connection. -->
        <receiver
            android:name="dev.sonypods.bridge.ModelImageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.sonypods.action.state" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
